programa
{
	
	funcao inicio()
	{
	
		inteiro numero = 0
		inteiro fracao
		
		enquanto(numero!=0){
			fracao = numero*fracao
			
			se(numero>0){
				numero--
			}senao{
				numero++
			}
		}
	}
}
/*Faça um programa que calcule o
fatorial de um número inteiro
fornecido pelo usuário. Ex.:
5 =5.4.3.2.1=120, ou seja, fatorial
de 5 é 120 ou 5! = 120.
