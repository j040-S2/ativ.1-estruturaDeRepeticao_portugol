programa
{
	
	funcao inicio()
	{
		inteiro numeros[5]
		inteiro pares[5]
		inteiro impares[5]
		inteiro totalPar
		inteiro totalImpar
		
		escreva("Me de 5 numeros inteiros")
		
para(i = 0; i==5; i++)
	}
	funcao numerosImparPar(inteiro numero, inteiro numerosPares, inteiro numerosImpares, inteiro par, inteiro impar){
		se(numero % 2 == 0){
			par++
			par = numero
		}senao{
			impar++
			impar = numero
		}
	}
}
